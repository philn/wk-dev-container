[Unit]
Description=WPEWebKit Clang Index Server container

[Container]
Image=wk-dev.image
AutoUpdate=registry
Volume=/home/phil/WebKit:/home/phil/WebKit:z
Exec=/usr/local/clangd-indexer/bin/clangd-index-server --server-address=0.0.0.0:50052 /home/phil/WebKit/wpe-clangd-index.idx /
PublishPort=50052

[Install]
WantedBy=local.target

[Service]
Restart=always
RuntimeMaxSec=2d
